{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Machinery CRM",
  "version": "0.1.0",
  "identifier": "com.machinerycrm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Machinery CRM",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Business",
    "shortDescription": "Machinery CRM desktop application",
    "longDescription": "Machinery CRM desktop application connected to your Supabase workspace"
  }
}
