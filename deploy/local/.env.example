# Copy to .env and replace the example values before deployment.
# This file is for the LOCAL backend deployment, not the Vite frontend.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ANON_KEY=replace-with-generated-supabase-anon-key
SERVICE_ROLE_KEY=replace-with-generated-supabase-service-role-key
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# LAN address of the computer hosting Machinery CRM.
# Reserve this address in the router so it does not change.
LAN_HOST=192.168.1.100
API_PORT=8000
STUDIO_PORT=3001
